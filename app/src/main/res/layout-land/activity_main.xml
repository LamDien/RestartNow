<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cockpit"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Vertical Guideline: 50% Left / 50% Right split -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.50" />

    <!-- Left Container: Hero Reboot Button & Info -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutLeftPane"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical"
        android:padding="8dp">

        <!-- Center Hero Reboot Button -->
        <FrameLayout
            android:id="@+id/btnReboot"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="@drawable/btn_reboot_ripple"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/btn_reboot"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tvButtonLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0.35">

            <!-- Reboot Master Icon -->
            <ImageView
                android:id="@+id/ivRebootIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:src="@drawable/btn_restartnow_master"
                android:contentDescription="@string/btn_reboot" />

            <!-- Circular Loading Spinner -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/cyan_primary"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Button Title: RestartNow -->
        <TextView
            android:id="@+id/tvButtonLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_reboot"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-black"
            app:layout_constraintBottom_toTopOf="@+id/tvSubtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnReboot" />

        <!-- Subtitle Helper -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/subtitle_ready"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            app:layout_constraintBottom_toTopOf="@+id/tvFooterTip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvButtonLabel" />

        <!-- Footer Version -->
        <TextView
            android:id="@+id/tvFooterTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/footer_version"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            app:layout_constraintBottom_toTopOf="@+id/tvAboutApp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

        <!-- Link to Show App Info Popup -->
        <TextView
            android:id="@+id/tvAboutApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="4dp"
            android:text="@string/link_about_app"
            android:textColor="@color/cyan_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFooterTip" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Right Container: AdMob Block (Hugs AdMob neatly without oversized border) -->
    <FrameLayout
        android:id="@+id/layoutAdCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ad_card"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Ad Placeholder View (Matches 300x250 Ad size) -->
        <LinearLayout
            android:id="@+id/layoutAdPlaceholder"
            android:layout_width="300dp"
            android:layout_height="250dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADVERTISEMENT"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:background="#1E293B"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ad_placeholder_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ad_placeholder_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Google AdMob AdView (Standard Full 300x250 Medium Rectangle) -->
        <com.google.android.gms.ads.AdView
            xmlns:ads="http://schemas.android.com/apk/res-auto"
            android:id="@+id/adView"
            android:layout_width="300dp"
            android:layout_height="250dp"
            android:layout_gravity="center"
            ads:adSize="MEDIUM_RECTANGLE"
            ads:adUnitId="@string/admob_ad_unit_test" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

