<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cockpit"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Center Hero Reboot Button (Matches App Icon) -->
    <FrameLayout
        android:id="@+id/btnReboot"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/btn_reboot_ripple"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/btn_reboot"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tvButtonLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.45">

        <!-- Modern Reboot Icon Image (Matches the App Icon: Glowing Cyan Arrow + Glowing Red Power Symbol) -->
        <ImageView
            android:id="@+id/ivRebootIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:src="@drawable/btn_restartnow_master"
            android:contentDescription="@string/btn_reboot" />

        <!-- Circular Loading Spinner (Hidden by default, centered at button center) -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/cyan_primary"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Button Title: RestartNow (Positioned directly below the circular button) -->
    <TextView
        android:id="@+id/tvButtonLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_reboot"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif-black"
        app:layout_constraintBottom_toTopOf="@+id/tvSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnReboot" />

    <!-- Subtitle Helper Description -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/subtitle_ready"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="sans-serif"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvButtonLabel" />

    <!-- Bottom Footer Tip -->
    <TextView
        android:id="@+id/tvFooterTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="Fast Root Reboot • SuperSU Certified"
        android:textColor="#475569"
        android:textSize="11sp"
        android:letterSpacing="0.05"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
