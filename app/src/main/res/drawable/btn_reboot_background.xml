<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 1: Ambient Outer Glow Ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/cyan_glow_light" />
        </shape>
    </item>

    <!-- Layer 2: Middle Cyan Glow Ring -->
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="oval">
            <solid android:color="@color/cyan_glow" />
            <stroke android:width="2dp" android:color="@color/cyan_secondary" />
        </shape>
    </item>

    <!-- Layer 3: Main Button Core (Dark Glass with Crisp Cyan Border) -->
    <item android:top="16dp" android:bottom="16dp" android:left="16dp" android:right="16dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="110dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#1E3A5F"
                android:centerColor="#0F1F35"
                android:endColor="#0A1322" />
            <stroke android:width="4dp" android:color="@color/cyan_primary" />
        </shape>
    </item>
</layer-list>
